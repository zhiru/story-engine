{
  "name": "@storygen/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file .env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file .env src/db/migrate.ts",
    "db:seed": "tsx --env-file .env src/db/seed.ts",
    "test": "node --env-file .env ../../node_modules/.bin/vitest run",
    "job:retention": "tsx --env-file .env src/jobs/retention.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/rate-limit": "^11.0.0",
    "@node-rs/argon2": "^2.0.2",
    "@sentry/node": "^10.59.0",
    "@storygen/shared": "workspace:*",
    "drizzle-orm": "^0.36",
    "fastify": "^5",
    "jsonwebtoken": "^9.0.3",
    "postgres": "^3.4"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22",
    "drizzle-kit": "^0.28",
    "tsx": "^4",
    "typescript": "^5.6",
    "vitest": "^2"
  }
}
