DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/storygen
PORT=3000
# Generate strong random secrets for production (e.g.: openssl rand -hex 32)
JWT_ACCESS_SECRET=dev-access-secret-change-me-in-production
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-in-production

# Billing (WP-A): RevenueCat webhook service auth (RF-50).
# Leave empty to disable the webhook (returns 503).
REVENUECAT_WEBHOOK_TOKEN=
# Grace period in days applied on BILLING_ISSUE before downgrading limits (RF-51)
GRACE_PERIOD_DAYS=3
# Clima real via OpenWeatherMap (RF-22) — opcional; sem chave, usa fallback determinístico
OPENWEATHER_API_KEY=
