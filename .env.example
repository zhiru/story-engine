# App (build-time) — apps/mobile/.env
APP_SLUG=historias-da-gigi
APP_MODE=SINGLE                 # MULTI | SINGLE
EXPO_PUBLIC_API_URL=http://127.0.0.1:3000

# API (server-side) — apps/api/.env (NUNCA versionar valores reais)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/storygen
PORT=3000
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
# IA — gateway compatível com OpenAI (OmniRoute -> Claude). Sem AI_API_KEY, usa o stub offline.
AI_BASE_URL=http://localhost:20128/v1
AI_API_KEY=                       # chave do gateway (secreta) — só no apps/api/.env
AI_MODEL=claude/claude-sonnet-4-6
# OPENWEATHER_API_KEY=      # WP4 (contexto de clima real; sem ela, fallback determinístico)
# REVENUECAT_WEBHOOK_SECRET=# WP5
